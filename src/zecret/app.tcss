/* Zecret Textual stylesheet.

   Conventions:

   - Colors come from Textual's theme variables ($surface, $accent, $error,
     $text-muted, ...), never hard-coded, so every theme in the picker
     works.
   - $accent frames anything you are working in. $error is reserved for
     errors, destructive actions, and the two places a master password is
     chosen or reached (.caution, #change-password).
   - Spacing is 1 cell vertically, 2 horizontally.
   - Rules are grouped by the role a widget plays (panel, title, hint,
     error, list), not by screen, so selectors list several ids at once.
   - The exception is the light-theme section at the foot of the file,
     which cuts across every role.
   - A component class does not answer to `:light`; the pseudo-class has to
     sit on the widget.
*/

/* --- Title bar ---------------------------------------------------------- */

/* Zecret's own header: one line, no icon, nothing to click. */
DiaryHeader {
    dock: top;
    width: 100%;
    height: 1;
    background: $panel;
    color: $foreground;
    content-align: center middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* --- Panels: the centred card used by unlock and settings --------------- */

UnlockScreen,
SettingsScreen,
PasswordScreen {
    align: center middle;
}

#unlock-box,
#settings-box {
    width: 62;
    height: auto;
    /* Scrolls inside its border on a short terminal. */
    max-height: 100%;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#unlock-title,
#password-title,
.section-title {
    width: 100%;
    content-align: center middle;
    text-style: bold;
    color: $text-accent;
    padding-bottom: 1;
}

#unlock-hint,
#password-hint,
.section-hint {
    width: 100%;
    color: $text-muted;
    padding-bottom: 1;
}

#unlock-box Input,
#password-box Input,
#settings-box Input,
/* The gap under a picker is what separates the settings sections. */
#settings-box Select {
    margin-bottom: 1;
}

/* 70 columns, not the 62 of the other cards: the extra eight bring the
   warning down from three lines to two, which is what lets the dialog fit
   a 24-row terminal without scrolling. See PasswordScreen.compose. */
#password-box {
    width: 70;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

/* Full width, to sit in the column the dropdowns make. Its red comes from
   variant="error": it is the one control on settings that leads to
   something irreversible. */
#change-password {
    width: 100%;
}

/* --- Error lines -------------------------------------------------------- */

/* The row is reserved whether or not there is a message, so showing one
   never shifts the fields. Fixed at one line: the password dialog's fit in
   24 rows depends on it. */
#unlock-error,
#password-error,
#editor-error,
#date-error {
    width: 100%;
    height: 1;
    color: $text-error;
}

/* The same row carrying a password-strength reading. Amber, not red:
   nothing has gone wrong and nothing is refused. */
#unlock-error.-advice,
#password-error.-advice {
    color: $text-warning;
}

/* Green once the password needs nothing said about it. */
#unlock-error.-advice.-advice-strong,
#password-error.-advice.-advice-strong {
    color: $text-success;
}

/* What the screen is doing while its fields are disabled for Argon2id.
   Muted: neither a complaint nor advice. */
#password-error.-status,
#unlock-error.-status {
    color: $text-muted;
}

/* --- The warning about a forgotten password ----------------------------- */

/* $error, because choosing a password is the step that makes losing the
   diary possible. Bordered on the left rather than bare red text, which in
   a form reads as a complaint about what was just typed.

   Named `.caution`, not `.warning`: Textual's Label reserves `.warning`
   for a variant of its own and paints $warning-muted behind it. */
.caution {
    width: 100%;
    color: $text-error;
    background: $error-muted;
    border-left: thick $error;
    padding: 0 1;
    margin-bottom: 1;
}

/* --- Lists: entry list and search results ------------------------------- */

/* Both are OptionLists, whose parts are component classes rather than
   child widgets, hence the `.option-list--*` selectors. */
#entries,
#results {
    height: 1fr;
    /* The 2-cell gutter every full-width screen shares. */
    margin: 0 2;
    padding: 0;
    background: $surface;
    border: none;

    /* A row holds the entry's whole first line and is trimmed here, at
       render time, so a resize costs nothing. Never trim by measuring in
       Python: that means rebuilding every row on resize. Rows must not
       wrap: a row is a day. */
    text-wrap: nowrap;
    text-overflow: ellipsis;

    /* Padding inside the row, so the highlight still runs full width. */
    & > .option-list--option {
        padding: 0 2;
    }

    & > .option-list--option-highlighted {
        color: $foreground;
        background: $accent-muted;
        text-style: bold;
    }

    /* OptionList tints its background while focused, which here is nearly
       always. Switched off so the panel matches the others. */
    &:focus {
        background-tint: $foreground 0%;
    }

    &:focus > .option-list--option-highlighted {
        background: $accent;
        color: $block-cursor-foreground;
        text-style: bold;
    }

    /* Month headings. Disabled only so the cursor skips them; they are
       styled as headings. Only headings are ever disabled. */
    & > .option-list--option-disabled {
        color: $text-accent;
        text-style: bold;
    }
}

/* --- Empty states ------------------------------------------------------- */

#entries-empty,
#search-empty {
    height: 1fr;
    width: 100%;
    content-align: center middle;
    color: $text-muted;
}

/* --- SearchScreen ------------------------------------------------------- */

/* Padding of 1, which is TextArea's, not Input's default 2. The margin
   lines the borders up with the other screens; this lines the text up.
   tests/test_chrome.py checks it. */
#query {
    margin: 0 2;
    padding: 0 1;
    border: round $border-blurred;

    &:focus {
        border: round $accent;
    }
}

/* --- EditorScreen ------------------------------------------------------- */

#editor-box {
    height: 1fr;
    padding: 1 2;
}

#editor-box #body {
    height: 1fr;
    margin-bottom: 1;
    border: round $border-blurred;

    &:focus {
        border: round $accent;
    }
}

/* A phrase written *between asterisks*, and the asterisks around it.

   Colour and bold together, never one. Bold is unreliable across terminals
   and fonts; colour is absent at sixteen colours and under NO_COLOR. They
   are independent parameters of one escape sequence, so each covers where
   the other gives out.

   $text-success was measured, not chosen. The test is distance from the
   prose on either side, not contrast against the page. Across the eight
   themes it sits furthest from the prose (ΔE 21.3 at worst, in Nord) and
   never falls below 4.2:1 against the page. $text-accent is behind on
   both. $text-primary has the best page contrast and the worst distance
   from the prose: in light themes it is a navy next to near-black text.
   Never $accent, which is a surface colour and already the editor's
   border.

   No `:light` twin: the text-* variables resolve against each theme's own
   page.

   The marks take the colour without the weight, so `*phrase*` reads as one
   thing while the writing outranks its marks. Dimming them instead does
   not work: this green at 70% opacity is 2.6:1 in the Light theme. */
DiaryTextArea > .diary-text-area--strong {
    color: $text-success;
    text-style: bold;
}

DiaryTextArea > .diary-text-area--strong-marker {
    color: $text-success;
}

/* The ink a masked word is drawn in (ctrl+r). Each covered character is
   swapped for a three-quarter block, so this is the colour of the bars. No
   background: the unfilled quarter of the cell is the gap between lines of
   redaction.

   The colour must be opaque. Characters too wide to swap are covered by
   painting them in ink the colour of their own background
   (DiaryTextArea.get_line), which rules out `auto` shades such as
   $text-muted and anything with a percentage: those blend differently for
   text than for background, and the character shows through.

   The dark and light rules are a matched pair and stay together here, not
   at the foot of the file: for the wide-character path each must be
   identical for text and background.

   Dark: slate, 2.7:1 against the page. Full-strength ink would be the
   brightest thing in the app. */
DiaryTextArea > .diary-text-area--mask {
    color: $panel-lighten-3;
}

/* Light: charcoal, 7.4:1. Dark enough that nothing shows through, without
   the harshness of pure black. */
DiaryTextArea:light > .diary-text-area--mask {
    color: $foreground-lighten-2;
}

/* Selecting text while it is masked. TextArea paints the selection after
   the mask and sets both colours, which would reveal the wide characters
   that are hidden by colour alone. So the selection gets a solid bar of
   its own. $accent is what the app selects with elsewhere, and is distinct
   from the mask in both light and dark. */
DiaryTextArea.-masked > .text-area--selection {
    color: $accent;
    background: $accent;
}

/* --- HelpScreen (modal) ------------------------------------------------- */

/* Wide enough for two columns of keys, inside 80 columns, and scrolling
   inside its border if taller than the terminal. */
#help-box {
    width: 76;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#help-logo {
    width: auto;
    color: $text-accent;
    /* Never wrapped. Narrow terminals hide it; see HelpScreen.fit_logo. */
    text-wrap: nowrap;
}

#help-tagline {
    width: 100%;
    color: $text-muted;
    padding-bottom: 1;
}

/* Here section titles head a list, so they sit at its left edge with the
   space above rather than below. */
#help-box .section-title {
    content-align: left middle;
    text-align: left;
    padding: 1 0 0 0;
}

/* Key rows are aligned into columns by the screen, which knows the widest
   key. */
.help-key {
    width: 100%;
}

/* Columns side by side. HelpScreen.fit_columns switches `layout` to
   vertical on a narrow terminal, which is why the height is auto. */
.help-columns {
    width: 100%;
    height: auto;
}

.help-column {
    width: 1fr;
    height: auto;
}

.help-note {
    width: 100%;
    color: $text-muted;
}

#help-close-hint {
    width: 100%;
    content-align: right middle;
    text-align: right;
    color: $text-muted;
}

/* --- Modals: confirm, date prompt and help ------------------------------ */

/* Dim what is behind them. */
ConfirmScreen,
DatePromptScreen,
HelpScreen {
    align: center middle;
    background: $background 60%;
}

/* Wide enough for three buttons side by side, and for the delete question
   on one line. */
#confirm-box {
    width: 70;
    max-width: 100%;
    height: auto;
    padding: 1 2;
    /* Red: this modal is only raised because something is about to be
       lost. */
    border: round $error;
    background: $surface;
}

#confirm-question {
    width: 100%;
    padding-bottom: 1;
}

#confirm-buttons {
    height: auto;
    align-horizontal: right;
}

/* One width for every answer, fitting the longest label ("Save and go
   back") plus the focus outline. Textual would size each to its own text.
   Widen this and #confirm-box together. */
#confirm-buttons Button {
    width: 20;
    margin-left: 2;
}

/* The gap goes between the answers only: three buttons and two gaps are
   64, exactly what #confirm-box holds. A margin on the first as well
   pushes the right-aligned row two cells over and clips Cancel's focus
   outline. */
#confirm-buttons Button:first-of-type {
    margin-left: 0;
}

/* Focus draws a closed frame round the button, in $accent as everywhere
   else. Textual's default reverses the label, which on a filled button
   makes the focused answer look switched off. A frame is a change of
   shape, so it does not depend on hue (an accent bar on the green Save
   button measures 1.16:1).

   `outline`, not `border`: a border is drawn inside the widget and takes
   two columns from the content, so the button would narrow on focus. An
   outline is painted over the edge. */
#confirm-buttons Button:focus {
    text-style: bold;
    outline: tall $accent;
}

/* --- DatePromptScreen (modal) ------------------------------------------- */

/* $accent, not $error: picking a day is not destructive. */
#date-box {
    width: 44;
    height: auto;
    /* Scrolls inside its border on a short terminal, costing the bottom of
       the calendar rather than the field. */
    max-height: 100%;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#date-title {
    width: 100%;
    text-style: bold;
    color: $text-accent;
    padding-bottom: 1;
}

#date-hint {
    width: 100%;
    color: $text-muted;
}

#date-box MaskedInput {
    border: round $border-blurred;

    &:focus {
        border: round $accent;
    }
}

#date-legend {
    width: 100%;
    color: $text-muted;
}

/* --- The month grid (the which-day modal, and every month of the year) -- */

/* Full width with the 28-column month centred in it
   (MonthCalendar.grid_left reads this alignment for clicks). Always eight
   rows: two headings and six weeks. */
MonthCalendar {
    width: 100%;
    height: 8;
    content-align-horizontal: center;
    margin: 1 0;
}

MonthCalendar > .month-calendar--month,
MonthGrid > .month-calendar--month {
    color: $text-accent;
    text-style: bold;
}

MonthCalendar > .month-calendar--heading,
MonthGrid > .month-calendar--heading {
    color: $text-muted;
}

MonthCalendar > .month-calendar--day,
MonthGrid > .month-calendar--day {
    color: $foreground;
}

/* A written day also carries a glyph, so the mark does not rest on colour
   alone. */
MonthCalendar > .month-calendar--written,
MonthGrid > .month-calendar--written {
    color: $text-accent;
    text-style: bold;
}

/* Today. Laid over whichever rule the day already answers to, so it must
   set only the style it adds and no colour. The legend draws its sample
   from this same rule. */
MonthCalendar > .month-calendar--today,
MonthGrid > .month-calendar--today,
CalendarLegend > .month-calendar--today {
    text-style: underline;
}

/* A day that has not happened; the cursor will not go there. */
MonthCalendar > .month-calendar--unavailable,
MonthGrid > .month-calendar--unavailable {
    color: $text-disabled;
}

/* The cursor, drawn as the entry list draws its selected row: soft while
   the grid is unfocused, solid while focused. */
MonthCalendar > .month-calendar--cursor,
MonthGrid > .month-calendar--cursor {
    background: $accent-muted;
    text-style: bold;
}

MonthCalendar:focus > .month-calendar--cursor,
YearCalendar:focus > MonthGrid > .month-calendar--cursor {
    background: $accent;
    color: $block-cursor-foreground;
}

/* --- CalendarScreen: the year laid out ---------------------------------- */

/* The same panel and gutter as the entry list. The year is centred inside
   it; see CalendarScreen.compose. */
#year-box {
    height: 1fr;
    margin: 0 2;
    padding: 1 2;
    background: $surface;
    /* Always reserved, so how many months fit across depends on width
       alone, which is all CalendarScreen.fit_months looks at. */
    scrollbar-gutter: stable;
}

#year-title {
    width: 100%;
    content-align: center middle;
    text-style: bold;
    color: $text-accent;
    padding-bottom: 1;
}

#year-legend {
    width: 100%;
    content-align: center middle;
    color: $text-muted;
    padding-top: 1;
}

/* Twelve months in a grid. Each is 21 columns (seven days of three) and
   eight rows. The column gutter is CalendarScreen's MONTH_GAP. */
YearCalendar {
    layout: grid;
    grid-size: 3;
    grid-columns: 21;
    grid-rows: 8;
    grid-gutter: 1 2;
    width: auto;
    height: auto;
}

MonthGrid {
    width: 21;
    height: 8;
}

/* How many months across, from the class CalendarScreen.fit_months sets.
   No five; see ACROSS there. Only the count is set: the width follows
   from it. The sizes written both here and in calendar_view.py are held
   together by tests/test_calendar_screen.py. */
CalendarScreen.-months-1 YearCalendar {
    grid-size: 1;
}

CalendarScreen.-months-2 YearCalendar {
    grid-size: 2;
}

CalendarScreen.-months-3 YearCalendar {
    grid-size: 3;
}

CalendarScreen.-months-4 YearCalendar {
    grid-size: 4;
}

CalendarScreen.-months-6 YearCalendar {
    grid-size: 6;
}

/* --- Light themes ------------------------------------------------------- */

/* Light and dark stack depth in opposite directions, and no theme variable
   can say so.

   On a dark page a raised thing is lighter than what is behind it, and
   Textual's dark greys are far enough apart to show it ($background
   #121212, $surface #1E1E1E, $panel #242F38). Its light greys are not
   (#E0E0E0, #D8D8D8, #D0D0D0): drawn the same way, every card dissolves
   into the page.

   So in light themes the model is inverted: cards are paper, lighter than
   the page, and bars are darker than it. Still theme variables only, and
   the derived shades keep each theme's hue.

   A new card must be added to the selector lists below.

   The mask's `:light` rule is not here but beside the rule it overrides;
   see the editor section. */

/* Darker than the page, so the bar has an edge. */
DiaryHeader:light {
    background: $panel-darken-1;
}

/* Every card: paper on a desk. */
#unlock-box:light,
#settings-box:light,
#password-box:light,
#help-box:light,
#confirm-box:light,
#date-box:light,
#entries:light,
#year-box:light,
#results:light {
    background: $surface-lighten-1;
}

/* A TextArea takes no background from the theme's surface, so it is given
   the cards' one. */
#editor-box #body:light {
    background: $surface-lighten-1;
}

/* $accent is the same orange in Textual's light theme as in its dark one
   and is too loud as a full-width row on a pale page. $block-cursor-* is
   what Textual itself selects with, so the list matches the Select on the
   settings screen. */
#entries:focus:light > .option-list--option-highlighted,
#results:focus:light > .option-list--option-highlighted {
    background: $block-cursor-background;
    color: $block-cursor-foreground;
}

/* The same substitution for the calendar's cursor. */
MonthCalendar:focus:light > .month-calendar--cursor,
YearCalendar:focus:light > MonthGrid > .month-calendar--cursor {
    background: $block-cursor-background;
    color: $block-cursor-foreground;
}

/* Textual's light themes colour footer keys with $primary. In light the
   card frames follow $border (which is $primary) so the app reads in one
   hue. $accent stays the heading colour. */
#unlock-box:light,
#settings-box:light,
#password-box:light,
#help-box:light,
#date-box:light,
#query:focus:light,
#editor-box #body:focus:light {
    border: round $border;
}
