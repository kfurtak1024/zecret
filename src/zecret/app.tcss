/* Zecret Textual stylesheet.

   Conventions, so the screens stay consistent as they grow:

   - Colors come from Textual's theme variables ($surface, $accent, $error,
     $text-muted, ...), never hard-coded. The app then follows whichever
     theme the user picks, light or dark, with no second palette to keep in
     sync.
   - $accent frames anything you are working in; $error is reserved for
     errors and destructive actions and is used nowhere else.
   - Spacing is 1 cell vertically, 2 horizontally. Terminal cells are about
     twice as tall as they are wide, so that pair reads as even.
   - Rules are grouped by the role a widget plays (panel, title, hint,
     error, list), not by the screen it happens to live on -- which is why
     selectors here list several ids at once.
   - One exception to that grouping, at the foot of the file: what the
     light themes need, which cuts across every role and is explained
     where it is written.
*/

/* --- Title bar ---------------------------------------------------------- */

/* Zecret's own header, not Textual's: one line, no icon, nothing to click.
   $panel keeps it distinct from the screen behind it without competing with
   $accent, which is reserved for what you are working in. */
DiaryHeader {
    dock: top;
    width: 100%;
    height: 1;
    background: $panel;
    color: $foreground;
    content-align: center middle;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* --- Panels: the centred card used by unlock and settings --------------- */

UnlockScreen,
SettingsScreen {
    align: center middle;
}

#unlock-box,
#settings-box {
    width: 62;
    height: auto;
    /* Never taller than the terminal: settings scrolls inside its border
       rather than running off the bottom of a short window. */
    max-height: 100%;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#unlock-title,
.section-title {
    width: 100%;
    content-align: center middle;
    text-style: bold;
    color: $text-accent;
    padding-bottom: 1;
}

#unlock-hint,
.section-hint {
    width: 100%;
    color: $text-muted;
    padding-bottom: 1;
}

#unlock-box Input,
#settings-box Input,
/* The gap under the theme picker is what separates the two sections of
   the settings screen; they need no rule of their own. */
#settings-box Select {
    margin-bottom: 1;
}

/* --- Error lines -------------------------------------------------------- */

/* Reserve the row whether or not there is a message, so showing one never
   shifts the fields under the user's cursor. */
#unlock-error,
#settings-error,
#editor-error,
#date-error {
    width: 100%;
    height: 1;
    color: $text-error;
}

/* --- Lists: entry list and search results ------------------------------- */

#entries,
#results {
    height: 1fr;
    /* Same 2-cell gutter as the search box above it and the editor's
       fields, so text lines up down the left edge of every screen. */
    margin: 0 2;
    background: $surface;
    border: none;

    & > ListItem {
        padding: 0 2;
        background: transparent;
    }

    /* A row shows as much of the entry's first line as the window has room
       for, and trims what will not fit with an ellipsis. Done here rather
       than by measuring the text in Python: the widget already knows how
       wide it is at render time, so a resize costs nothing, where
       recomputing the rows would mean rebuilding every one of them on
       every event of a window drag. Rows must not wrap either -- a row is
       a day, and a day that took two lines would break the alignment the
       whole list is read by. */
    & > ListItem > Label {
        width: 100%;
        text-wrap: nowrap;
        text-overflow: ellipsis;
    }

    /* The selected row is the one thing the eye should find instantly. */
    & > ListItem.-highlight {
        background: $accent-muted;
        text-style: bold;
    }

    &:focus > ListItem.-highlight {
        background: $accent;
        color: $block-cursor-foreground;
    }

    /* Month headings. Disabled so the cursor skips them, which is a
       navigation decision, not a visual one -- they read as headings, not
       as something unavailable. */
    & > ListItem.group-heading {
        padding: 1 2 0 2;
        color: $text-accent;
        text-style: bold;
    }
}

/* --- Empty states ------------------------------------------------------- */

#entries-empty,
#search-empty {
    height: 1fr;
    width: 100%;
    content-align: center middle;
    color: $text-muted;
}

/* --- SearchScreen ------------------------------------------------------- */

/* The 1-cell padding is TextArea's, not Input's. Input pads by 2 inside
   its border and TextArea by 1, so with both bordered at the same column
   the query sat one cell right of the results listed directly under it --
   and one cell right of the editor, which is the other full-width field
   in the app. The margin lines the borders up; this lines the text up,
   which is the part anyone actually reads down. */
#query {
    margin: 0 2;
    padding: 0 1;
    border: round $border-blurred;

    &:focus {
        border: round $accent;
    }
}

/* --- EditorScreen ------------------------------------------------------- */

#editor-box {
    height: 1fr;
    padding: 1 2;
}

#editor-box #body {
    height: 1fr;
    margin-bottom: 1;
    border: round $border-blurred;

    &:focus {
        border: round $accent;
    }
}

/* The ink a masked word is drawn in (ctrl+r). Each covered character is
   swapped for a three-quarter block, so this is the colour of the bars
   themselves against the ordinary page behind them -- no background here,
   because the quarter of the cell the bar does not fill is what puts a
   gap between one line of redaction and the next.

   The colour still has to be opaque, since the handful of characters too
   wide to swap are covered by painting them in ink the colour of their
   own background instead (DiaryTextArea.get_line). That rules out
   $text-muted and the other `auto` shades, which a background cannot
   take at all, and anything with a percentage: those blend against
   different grounds for text than for background, so the two come out a
   shade apart and the character is legible again.

   Two rules rather than one because a bar is a different problem on a
   dark page than on a pale one, and no single variable is right for both
   -- the same reason the `:light` section at the foot of this file
   exists. Note that the pseudo-class has to sit on the *widget*: a
   component class does not answer to `:light` itself.

   Slate on dark, at 2.7:1 against the page. Full-strength ink there is a
   wall of light to sit in front of, and brighter than anything else in
   the app -- the point is to cover the writing, not to shout. */
DiaryTextArea > .diary-text-area--mask {
    color: $panel-lighten-3;
}

/* Charcoal on a pale page, at 7.4:1. Pure black is what a censor's marker
   actually leaves and it is tempting for that reason, but a screenful of
   it is harsh to write behind, and a diary is not a document being
   released. Dark enough that nothing shows through, quiet enough to sit
   with. */
DiaryTextArea:light > .diary-text-area--mask {
    color: $foreground-lighten-2;
}

/* Selecting text while it is masked. TextArea paints the selection after
   the mask and sets both colours, which back when every character was
   hidden by colour alone meant ctrl+a laid the whole entry bare on a
   screen that was supposed to be covered. Swapping the glyphs closed that
   -- a character that is not there cannot be revealed -- but the wide
   characters are still hidden by colour, so the selection gets a bar of
   its own and the hole stays shut for them too.
   $accent, which is the colour this app already selects with: the
   highlighted row in the entry list wears it too. It is legible against
   the mask in either theme, which $foreground-darken-1 is not -- on a
   pale theme the two come out a hair apart. */
DiaryTextArea.-masked > .text-area--selection {
    color: $accent;
    background: $accent;
}

/* --- HelpScreen (modal) ------------------------------------------------- */

/* Wide enough for two columns of keys side by side, and never taller than
   the terminal: the help scrolls inside its own border rather than off the
   bottom of the screen. The width is spent to buy height back -- eighteen
   keys in one column is a page you scroll, and the same eighteen in two is
   most of a page you do not. It still lands inside eighty columns, which
   is the width the rest of the app is built to. */
#help-box {
    width: 76;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#help-logo {
    width: auto;
    color: $text-accent;
    /* The art is drawn, not written: wrapping it would make nonsense of
       it. Narrow terminals hide it instead -- see HelpScreen.fit_logo. */
    text-wrap: nowrap;
}

#help-tagline {
    width: 100%;
    color: $text-muted;
    padding-bottom: 1;
}

/* Section titles are centred where they head a narrow card; here they head
   a list, so they read as headings only if they sit at the left edge of
   what they introduce, with air above rather than below. */
#help-box .section-title {
    content-align: left middle;
    text-align: left;
    padding: 1 0 0 0;
}

/* The key rows are aligned into columns by the screen itself, since only
   it knows how wide the widest key in a section is. */
.help-key {
    width: 100%;
}

/* Two columns side by side. `layout` is switched to vertical by
   HelpScreen.fit_columns when the terminal is too narrow to pair them,
   which is why the height must be auto rather than a fraction: stacked,
   these have to grow to whatever they hold. */
.help-columns {
    width: 100%;
    height: auto;
}

.help-column {
    width: 1fr;
    height: auto;
}

/* A tight list, like the key rows above: each note is one line, and the
   section heading already gives the group its air. */
.help-note {
    width: 100%;
    color: $text-muted;
}

/* No padding above it: this is the one line someone who feels stuck needs
   to see, so it earns its place inside the fold rather than a row of air. */
#help-close-hint {
    width: 100%;
    content-align: right middle;
    text-align: right;
    color: $text-muted;
}

/* --- Modals: confirm, date prompt and help ------------------------------ */

/* Dim what is behind them: the question is the only thing to answer, and
   help sits over the diary rather than replacing it. */
ConfirmScreen,
DatePromptScreen,
HelpScreen {
    align: center middle;
    background: $background 60%;
}

/* Wide enough for three buttons side by side, which is what the
   questions about unsaved writing ask. Still inside an eighty-column
   terminal with room to spare -- the help popup is wider than this -- and
   it keeps the delete question, the longest sentence this modal carries,
   on one line. */
#confirm-box {
    width: 70;
    max-width: 100%;
    height: auto;
    padding: 1 2;
    /* Red framing: this modal is only ever raised because something is
       about to be lost. That two of its three answers now keep the
       writing is the buttons' business -- the frame is about why you are
       being stopped, not about which way out you take. */
    border: round $error;
    background: $surface;
}

#confirm-question {
    width: 100%;
    padding-bottom: 1;
}

#confirm-buttons {
    height: auto;
    align-horizontal: right;
}

/* One width for every answer, wide enough for the longest label this
   modal carries ("Save and go back") plus the frame focus draws around
   it. Textual sizes a button to its own text against a floor of sixteen
   cells, which left three answers to one question at three different
   widths -- and made "Cancel" almost as wide as "Save and go back", so
   the row read as a near-miss rather than as a set. Widen this and
   #confirm-box together, and leave a cell clear at each end for the frame
   focus draws over them. */
#confirm-buttons Button {
    width: 20;
    margin-left: 2;
}

/* The gap goes *between* the answers, so the row needs exactly as much
   room as the buttons and the gaps between them -- three of these and two
   gaps is 64, which is what #confirm-box holds. A margin on the first one
   as well put the row two cells over that, and since it is aligned right
   it was the last button that hung off the end: Cancel lost the right
   edge of its focus frame to the clip, and only Cancel, only when
   focused, which is a thing you see rather than a thing that fails. */
#confirm-buttons Button:first-of-type {
    margin-left: 0;
}

/* Focus draws a frame right round the button.
   Textual's own answer is to reverse the label, which on a filled button
   swaps its fill for the page behind it: the answer being offered was the
   one that looked switched off, and the two beside it looked chosen.
   Marking the top and bottom edges in $accent instead fixed the reading
   but not the seeing -- an accent bar against the green of Save measures
   1.16:1, against the 1.7-2.1:1 that the unfocused buttons' own shading
   already has, so the cue was fainter than the decoration it competed
   with, and it was carried by hue alone on the one pairing (orange on
   green) that colour blindness takes away.
   A closed frame is a change of shape, which survives both: its outer
   edge sits against the modal's own background wherever the fill is too
   close in tone to read against. $accent because that is what marks the
   focused thing everywhere else here -- the search box, the page you
   write on.
   `outline` rather than `border`, which is the whole reason this rule can
   exist at all: a Textual border is drawn inside the widget and takes its
   two columns out of the content, so a button visibly narrowed by two
   cells as you tabbed onto it -- and a label one cell longer would have
   wrapped rather than shrunk. An outline is painted over the edge it sits
   on, so the answer stays exactly the size it was and only the two cells
   at its ends change colour. The elsewhere-in-this-file version of the
   same trick is a border that is always there and only changes colour on
   focus; a Button already spends its border on the shading that makes it
   look like a button, so there is none spare to recolour. */
#confirm-buttons Button:focus {
    text-style: bold;
    outline: tall $accent;
}

/* --- DatePromptScreen (modal) ------------------------------------------- */

/* $accent, not $error: picking a day is where you start writing, not a
   destructive step. */
#date-box {
    width: 44;
    height: auto;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#date-title {
    width: 100%;
    text-style: bold;
    color: $text-accent;
    padding-bottom: 1;
}

#date-hint {
    width: 100%;
    color: $text-muted;
}

#date-box MaskedInput {
    border: round $border-blurred;

    &:focus {
        border: round $accent;
    }
}

/* --- Light themes ------------------------------------------------------- */

/* Everything above is written in theme variables, and that is what lets
   all eight themes in the picker work from one stylesheet. What a variable
   cannot express is that light and dark stack depth in opposite
   directions.

   On a dark page a raised thing is lighter than what is behind it, and
   Textual's dark palette spaces its three greys far enough apart to show
   that: $background #121212, $surface #1E1E1E, $panel #242F38. Its light
   palette does not -- #E0E0E0, #D8D8D8 and #D0D0D0, eight steps apart
   each. Drawn the same way, every card in the app dissolves into the page
   behind it and the title bar stops reading as a bar at all; the editor
   became one flat wash of grey with a floating orange rectangle in it.

   So the light half inverts the model rather than repeating it: cards are
   paper, lighter than the page they sit on, and the bars are darker than
   it. `:light` is one of Textual's own pseudo-classes, so this stays a
   single stylesheet in theme variables -- not a second palette to keep in
   sync, and still not a hard-coded color anywhere. The derived shades keep
   each theme's hue, which is why Solarized stays cream and Latte stays
   cool rather than both flattening to white.

   Not quite everything the light themes change is here: the mask's bar
   colour (ctrl+r, up with the editor) keeps its `:light` rule beside the
   rule it overrides, because the two have to hold identical colours for a
   word to stay covered and splitting them across the file is how one of
   them gets changed alone. */

/* Darker than the page, not lighter, so the bar has an edge to it. */
DiaryHeader:light {
    background: $panel-darken-1;
}

/* Paper on a desk. Every card in the app is one selector list because
   they are all the same idea -- see the panel rules above. */
#unlock-box:light,
#settings-box:light,
#help-box:light,
#confirm-box:light,
#date-box:light,
#entries:light,
#results:light {
    background: $surface-lighten-1;
}

/* The page you write on, most of all. A TextArea takes no background from
   the theme's surface, so on a light theme the editor came out the same
   grey as everything around it -- the one screen in the app that should
   look like something to write on. */
#editor-box #body:light {
    background: $surface-lighten-1;
}

/* $accent is the same #FEA62B in Textual's light theme as in its dark one
   -- it is not re-tuned for a pale background, and a full-width row of it
   is a fluorescent slab rather than a highlight. $block-cursor-* is what
   Textual selects a row with everywhere else, so the list now agrees with
   the Select and OptionList on the settings screen instead of shouting
   over them. Dark keeps the orange: on a dark page it reads as warmth. */
#entries:focus > ListItem.-highlight:light,
#results:focus > ListItem.-highlight:light {
    background: $block-cursor-background;
    color: $block-cursor-foreground;
}

/* Textual's light themes point their footer keys at $primary and leave
   $accent at the dark theme's orange, so a card framed in $accent sat next
   to a blue key bar with nothing relating the two. In light the frame
   follows $border -- which is $primary, and so is the selected row above
   -- and the app reads in one hue instead of three. $accent is still the
   heading color, where the light palette resolves it to a brown that sits
   quietly on paper. Dark is untouched: there, $accent is the whole point. */
#unlock-box:light,
#settings-box:light,
#help-box:light,
#date-box:light,
#query:focus:light,
#editor-box #body:focus:light {
    border: round $border;
}
